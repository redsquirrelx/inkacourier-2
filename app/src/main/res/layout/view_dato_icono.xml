<?xml version="1.0" encoding="utf-8"?>
<!-- Dato con icono: valor principal y descripción. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgDato"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        app:tint="@color/primario"
        tools:src="@drawable/ic_ubicacion" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPrincipal"
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Av. Los Olivos 245" />

        <TextView
            android:id="@+id/txtSecundario"
            style="@style/Texto.Soporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Surquillo, Lima" />
    </LinearLayout>
</LinearLayout>
