<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso: icono, título y texto. El color lo asigna mostrarAviso(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizAviso"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_aviso"
    android:orientation="horizontal"
    android:padding="16dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/imgAviso"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            tools:text="Sin conexión" />

        <TextView
            android:id="@+id/txtTextoAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp"
            tools:text="Datos guardados en el dispositivo." />
    </LinearLayout>
</LinearLayout>
