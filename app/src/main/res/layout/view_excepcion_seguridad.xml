<?xml version="1.0" encoding="utf-8"?>
<!-- Excepción de seguridad registrada, de solo lectura (RF-14, RF-15, RF-22). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Tarjeta">

    <LinearLayout style="@style/Tarjeta.Contenido">

        <TextView
            style="@style/Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/excepcion_seguridad" />

        <include
            android:id="@+id/avisoExoneracion"
            layout="@layout/view_aviso" />

        <LinearLayout
            android:id="@+id/contenedorExcepcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/espacio_12"
            android:orientation="vertical"
            android:showDividers="middle" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
