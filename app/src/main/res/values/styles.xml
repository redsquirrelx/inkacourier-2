<?xml version="1.0" encoding="utf-8"?>
<!-- Equivalencias de componentes.css (diseno/interfaces/mapeo-android.yaml). -->
<resources>

    <!-- Contenedores -->
    <style name="Contenido.Pagina" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:divider">@drawable/espacio_16</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/md_card</item>
        <item name="strokeColor">@color/md_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Tarjeta.Tonal">
        <item name="cardBackgroundColor">@color/md_surface_container</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Tarjeta.Contenido" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:divider">@drawable/espacio_12</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="Acciones">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/fondo_acciones</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:divider">@drawable/espacio_8</item>
        <item name="android:showDividers">middle</item>
    </style>

    <!-- Tipografía -->
    <style name="Texto">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Texto.Overline">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <style name="Texto.Seccion">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Texto.Subtitulo">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Texto.Cuerpo">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Texto.Soporte">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <style name="Texto.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <style name="Texto.Importe">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Texto.Insignia">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/fondo_insignia</item>
    </style>

    <!-- Componentes Material -->
    <style name="Widget.InkaCourier.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="Widget.InkaCourier.Boton.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="strokeColor">@color/md_outline</item>
    </style>

    <style name="Widget.InkaCourier.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.InkaCourier.Segmento" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/md_outline</item>
        <item name="android:textColor">@color/texto_segmento</item>
        <item name="backgroundTint">@color/fondo_segmento</item>
        <item name="iconTint">@color/md_on_secondary_container</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="Widget.InkaCourier.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeColor">@color/md_primary</item>
    </style>

    <style name="Widget.InkaCourier.CampoTexto.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeColor">@color/md_primary</item>
    </style>

    <style name="Widget.InkaCourier.Casilla" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <!-- Fotografía de fachada (.photo): esquinas de 12 dp -->
    <style name="Forma.Imagen" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Diálogo de firma: superficie con radio de 28 dp y margen exterior de 20 dp -->
    <style name="Dialogo.Firma" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@drawable/fondo_dialogo</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
