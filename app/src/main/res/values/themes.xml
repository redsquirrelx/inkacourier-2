<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 claro con la paleta verde petróleo de la aplicación. -->
    <style name="Base.Theme.InkaCourier_App" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/sobre_primario</item>
        <item name="colorPrimaryContainer">@color/contenedor_primario</item>
        <item name="colorOnPrimaryContainer">@color/sobre_contenedor_primario</item>
        <item name="colorSecondary">@color/secundario</item>
        <item name="colorSecondaryContainer">@color/contenedor_secundario</item>
        <item name="colorOnSecondaryContainer">@color/sobre_contenedor_secundario</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/sobre_superficie</item>
        <item name="colorOnSurfaceVariant">@color/sobre_superficie_variante</item>
        <item name="colorSurfaceContainer">@color/contenedor_superficie</item>
        <item name="colorSurfaceContainerHigh">@color/contenedor_superficie</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="colorOutlineVariant">@color/contorno_variante</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/superficie</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="textInputStyle">@style/Widget.InkaCourier.CampoTexto</item>
        <item name="materialButtonStyle">@style/Widget.InkaCourier.Boton</item>
        <item name="checkboxStyle">@style/Widget.InkaCourier.Casilla</item>
    </style>

    <style name="Theme.InkaCourier_App" parent="Base.Theme.InkaCourier_App" />
</resources>
